{
  "info": {
    "name": "AEGIS Backend — Local acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order with local Backend + AI running. Prepare fixtures first. Creates 2 fresh local test accounts and 1 analysis per run. No fixed confidence/detection-count assumption. See postman/README.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "type": "string",
        "value": "{{access_token}}"
      }
    ]
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Backend alive\", () => pm.expect(pm.response.json().service).to.eql(\"aegis-backend\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register owner (fresh account each run)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id=pm.variables.replaceIn('{{$guid}}');",
              "pm.environment.set('email', 'postman-'+id+'@example.test');",
              "pm.environment.set('password', 'Test-'+id);",
              "['access_token','user_id','analysis_id','image_url','other_token','other_user_id','detection_request_id','model_sha256'].forEach(k=>pm.environment.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.environment.set(\"user_id\",pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
