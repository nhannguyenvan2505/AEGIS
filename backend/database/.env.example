# Copy to .env and replace every placeholder before starting Compose.
AEGIS_MYSQL_ROOT_PASSWORD=replace-with-local-root-password
AEGIS_MYSQL_PASSWORD=replace-with-local-app-password
AEGIS_MYSQL_PORT=3307
AEGIS_MONGO_ROOT_PASSWORD=replace-with-local-root-password
AEGIS_MONGO_PASSWORD=replace-with-local-app-password
AEGIS_MONGO_PORT=27018
# Native MySQL without MongoDB: set this to 0; outbox payloads remain in MySQL.
AEGIS_MONGO_DELIVERY_ENABLED=1
# Khi deploy: cho backend dùng tài khoản chỉ đọc/ghi dữ liệu (database/create_runtime_user.py),
# còn migrate.py và backup_deploy.py dùng tài khoản có quyền đổi schema dưới đây.
# AEGIS_MYSQL_MIGRATION_USER=
# AEGIS_MYSQL_MIGRATION_PASSWORD=
