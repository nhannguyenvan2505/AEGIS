AEGIS_MYSQL_PASSWORD=replace-with-local-app-password
AEGIS_MYSQL_PORT=3307
AEGIS_MONGO_ROOT_PASSWORD=replace-with-local-root-password
AEGIS_MONGO_PASSWORD=replace-with-local-app-password
AEGIS_MONGO_PORT=27018
