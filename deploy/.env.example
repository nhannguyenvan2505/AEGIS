# Copy to deploy/.env on the server (chmod 600) and fill in. deploy/.env is not committed.
# Generate every secret separately, for example:  openssl rand -hex 32
# Keep a copy of these values apart from the backups: backups do not contain them.

# Public name of the API. DNS must point here and ports 80/443 must be reachable.
AEGIS_DOMAIN=aegis.example.com
# Name devices use for the broker; the certificate made by mqtt.sh carries it.
AEGIS_MQTT_HOSTNAME=mqtt.example.com

AEGIS_MYSQL_ROOT_PASSWORD=
AEGIS_MYSQL_MIGRATION_PASSWORD=
# At least 16 characters.
AEGIS_MYSQL_RUNTIME_PASSWORD=
AEGIS_MONGO_ROOT_PASSWORD=
AEGIS_MONGO_PASSWORD=
# At least 32 characters. Changing it signs everyone out.
AEGIS_JWT_SECRET=
AEGIS_MQTT_BACKEND_PASSWORD=

# Optional.
# AEGIS_MODELS_DIR=../ai_service/experiments
# MongoDB cache in GB.
# AEGIS_MONGO_CACHE_GB=0.5
# AEGIS_AI_MAX_INFLIGHT=2
# Origins of a web admin served elsewhere, comma separated, e.g. https://admin.example.com
# AEGIS_ADMIN_ALLOWED_ORIGINS=
# Broker listening address on the host.
# AEGIS_MQTT_BIND=0.0.0.0
# Push is off until set to 1 and the "push" profile is started.
# AEGIS_PUSH_ENABLED=0
# EXPO_ACCESS_TOKEN=
